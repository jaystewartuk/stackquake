{
  "package.json": "{\"name\":\"acme\",\"private\":true,\"workspaces\":[\"apps/*\",\"packages/*\"],\"devDependencies\":{\"turbo\":\"^2.1.0\",\"typescript\":\"^5.6.0\"},\"engines\":{\"node\":\">=20\"}}",
  "pnpm-workspace.yaml": "packages:\n  - apps/*\n  - packages/*\n",
  ".nvmrc": "20.11.1\n",
  "README.md": "# Acme\n",
  "vercel.json": "{}",
  "docker-compose.yml": "services:\n  db:\n    image: postgres:16-alpine\n  cache:\n    image: redis:7.2\n",
  ".github/workflows/ci.yml": "jobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n",
  "apps/web/package.json": "{\"name\":\"@acme/web\",\"dependencies\":{\"next\":\"15.0.3\",\"react\":\"19.0.0\",\"@supabase/supabase-js\":\"^2.45.0\",\"@acme/ui\":\"workspace:*\"},\"devDependencies\":{\"eslint\":\"^9\"}}",
  "apps/web/next.config.mjs": "export default {}",
  "apps/api/package.json": "{\"name\":\"@acme/api\",\"dependencies\":{\"hono\":\"^4.6.0\",\"zod\":\"^3.23.0\",\"@acme/ui\":\"workspace:*\"},\"devDependencies\":{\"wrangler\":\"^3.80.0\",\"@cloudflare/workers-types\":\"^4\"}}",
  "apps/api/wrangler.toml": "name = \"acme-api\"\nmain = \"src/index.ts\"\n",
  "apps/api/src/index.ts": "export default {}",
  "apps/worker/Dockerfile": "FROM python:3.12-slim AS base\nFROM base\nCOPY . .\n",
  "apps/worker/requirements.txt": "fastapi==0.115.0\nuvicorn[standard]>=0.30\n",
  "packages/ui/package.json": "{\"name\":\"@acme/ui\",\"dependencies\":{\"class-variance-authority\":\"^0.7.0\"},\"peerDependencies\":{\"react\":\"^19\"}}",
  "supabase/config.toml": "project_id = \"acme\"\n",
  "infra/main.tf": "terraform {\n  required_providers {\n    cloudflare = { source = \"cloudflare/cloudflare\" }\n  }\n}\n",
  "docs/package.json": "{\"name\":\"docs\",\"dependencies\":{\"docusaurus\":\"^3\"}}",
  "examples/demo/package.json": "{\"name\":\"demo\",\"dependencies\":{\"express\":\"^4\"}}"
}
