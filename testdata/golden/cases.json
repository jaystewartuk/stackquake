          "type": "text/markdown; charset=utf-8"
        }
      },
      "expect": {
        "kind": null
      }
    },
    {
      "id": "05-cloudflare-timestamp-only",
      "spec": 5,
      "what": "Synthetic: the same pricing page with only the 'Last updated' date changed.",
      "type": "page",
      "catalog": "cloudflare-workers",
      "page": {
        "url": "https://developers.cloudflare.com/workers/platform/pricing/",
        "selector": "main",
        "type": "text/markdown; charset=utf-8",
        "before": "pages/cloudflare-workers-pricing.md",
        "after": "pages/cloudflare-workers-pricing.timestamp-only.md"
      },
      "expect": {
        "kind": null,
        "llm_calls": 0
      }
    },
    {
      "id": "06-npm-busl",
      "spec": 6,
      "what": "Fixture: an npm package's latest version moves from MIT to BUSL-1.1.",
      "type": "npm",
      "package": "left-pad-pro",
      "before": {
        "name": "left-pad-pro",
        "version": "1.4.2",
        "license": "MIT",
        "repository": {
          "type": "git",
          "url": "git+https://github.com/acme/left-pad-pro.git"
        }
      },
      "after": {
        "name": "left-pad-pro",
        "version": "2.0.0",
        "license": "BUSL-1.1",
        "repository": {
          "type": "git",
          "url": "git+https://github.com/acme/left-pad-pro.git"
        }
      },
      "expect": {
        "kind": "license",
        "status": "published"
      }
    },
    {
      "id": "07-github-archived",
      "spec": 7,
      "what": "Fixture: a GitHub repository becomes archived.",
      "type": "github",
      "repo": "acme/widget",
      "before": {
        "full_name": "acme/widget",
        "owner": {
          "login": "acme"
        },
        "archived": false,
        "license": {
          "spdx_id": "MIT"
        }
      },
      "after": {
        "full_name": "acme/widget",
        "owner": {
          "login": "acme"
        },
        "archived": true,
        "license": {
          "spdx_id": "MIT"
        }
      },
      "license": {
        "path": "LICENSE",
        "sha": "0b1c2d",
        "encoding": "base64",
        "content": "TUlUIExpY2Vuc2UK"
      },
      "expect": {
        "kind": "archived",
        "status": "published"
      }
    },
