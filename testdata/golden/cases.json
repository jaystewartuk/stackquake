{
  "about": "Golden set for the M2 pipeline (SPEC §11). Real sources saved on 2026-10-10 unless marked synthetic. See README.md.",
  "cases": [
    {
      "id": "01-deno-eol",
      "spec": 1,
      "what": "Deno blog post of 2026-10-09: the team joins Cloudflare; the runtime gets one more year of fixes, then development ends.",
      "type": "feed",
      "catalog": "deno",
      "feed": {
        "url": "https://deno.com/feed",
        "file": "feeds/deno.atom"
      },
      "item": "https://deno.com/blog/cloudflare",
      "posts": {
        "https://deno.com/blog/cloudflare": {
          "file": "posts/deno-cloudflare.html",
          "type": "text/html; charset=utf-8"
        }
      },
      "expect": {
        "kind": "eol",
        "effective_date_prefix": "2027-10",
        "quote_contains": "end our development of the Deno runtime"
      }
    },
    {
      "id": "02-bitwarden-license",
      "spec": 2,
      "what": "Bitwarden forum announcement of 2026-10-09 (HN 50033407, 'Bitwarden Dual License Model'): store builds become the commercially licensed builds; GPLv3 builds continue on GitHub.",
      "type": "feed",
      "catalog": "bitwarden",
      "feed": {
        "url": "https://community.bitwarden.com/c/announcements/72.rss",
        "file": "feeds/bitwarden-announcements.rss"
      },
      "item": "https://community.bitwarden.com/t/published-version-update-in-app-stores/102750",
      "posts": {
        "https://community.bitwarden.com/t/published-version-update-in-app-stores/102750": {
          "file": "posts/bitwarden-published-version-update.md",
          "type": "text/markdown; charset=utf-8"
        }
      },
      "expect": {
        "kind": "license"
      }
    },
    {
      "id": "03-cloudflare-free-tier",
      "spec": 3,
      "what": "Synthetic edit of the saved Cloudflare Workers pricing page: Free plan requests cut from 100,000 to 50,000 per day (and the 'Last updated' date moves).",
      "type": "page",
      "catalog": "cloudflare-workers",
      "page": {
        "url": "https://developers.cloudflare.com/workers/platform/pricing/",
        "selector": "main",
        "type": "text/markdown; charset=utf-8",
        "before": "pages/cloudflare-workers-pricing.md",
        "after": "pages/cloudflare-workers-pricing.free-tier-edit.md"
      },
      "expect": {
        "kind": "free_tier",
        "note_mentions": [
          "100,000",
          "50,000"
        ]
      }
    },
    {
      "id": "04-cloudflare-routine-post",
      "spec": 4,
      "what": "Routine product announcement on the Cloudflare blog (on-demand CPU profiling for Workers). Passes the catalog keyword filter.",
      "type": "feed",
      "catalog": "cloudflare-workers",
      "feed": {
        "url": "https://blog.cloudflare.com/rss/",
        "file": "feeds/cloudflare-blog.rss"
      },
      "item": "https://blog.cloudflare.com/workers-on-demand-profiling/",
      "posts": {
        "https://blog.cloudflare.com/workers-on-demand-profiling/": {
