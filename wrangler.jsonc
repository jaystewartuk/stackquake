{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stackquake",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Generates src/catalog/catalog.gen.json from catalog/*.yaml before dev and deploy.
  "build": { "command": "node scripts/build-catalog.mjs" },
  "triggers": {
    // */5: claim and run due jobs. Daily: sync catalog, schedule overdue polls, prune.
    "crons": ["*/5 * * * *", "7 6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stackquake",
      // Placeholder until M5 creates the real database. Local dev and tests only.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "stackquake-snapshots" }],
  "vars": {
    "JOBS_PER_TICK": "3",
    // Model per pipeline step (docs/DECISIONS.md, M2). Changing one is a config change only.
    "LLM_MODEL_CLASSIFY": "claude-haiku-5-5",
    "LLM_MODEL_SUMMARISE": "claude-haiku-5-5",
    "LLM_MODEL_SUMMARISE_HIGH": "claude-opus-5-5"
  },
  // Secrets (wrangler secret put / .dev.vars): ANTHROPIC_API_KEY, ADMIN_TOKEN, GITHUB_TOKEN.
  "observability": { "enabled": true }
}
