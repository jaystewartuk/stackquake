// Two deployed environments (docs/DECISIONS.md, M5):
//   production  `npm run deploy:production` (top level)  → stackquake.com, 3 cron triggers
//   staging     `npm run deploy:staging` (env.staging)    → staging.stackquake.com, no cron
// `wrangler dev` and the tests use the top level with local D1 and R2.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stackquake",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Generates src/catalog/catalog.gen.json from catalog/*.yaml before dev and deploy.
  "build": { "command": "node scripts/build-catalog.mjs" },
  "triggers": {
    // */5 and 3-58/5: claim and run due jobs (two ticks every 5 minutes, each with its own CPU
    // budget). Daily: sync catalog, schedule overdue polls, digests, budget check, prune.
    // 3 of the account's 5 Free-plan cron triggers.
    "crons": ["*/5 * * * *", "3-58/5 * * * *", "7 6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stackquake",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "stackquake-snapshots" }],
  // www only redirects to the apex (src/web/index.tsx).
  "routes": [
    { "pattern": "stackquake.com", "custom_domain": true },
    { "pattern": "www.stackquake.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "vars": {
    // Workers Paid since 2026-10-11 (30 s CPU per invocation; docs/DECISIONS.md, M6 "Production CPU").
    // On the Free plan these were 3 / 2 / 1.
    "JOBS_PER_TICK": "20",
    // Fan-out, delivery and digest jobs per tick, on top of JOBS_PER_TICK (docs/DECISIONS.md, M4).
    "ALERT_JOBS_PER_TICK": "10",
    // CPU-heavy steps (pages, feeds, diffs, post fetches) per tick. Website hosts stay at one per tick.
    "HEAVY_PER_TICK": "10",
    // Model per pipeline step (docs/DECISIONS.md, M2). Changing one is a config change only.
    "LLM_MODEL_CLASSIFY": "claude-haiku-5-5",
    "LLM_MODEL_SUMMARISE": "claude-haiku-5-5",
    "LLM_MODEL_SUMMARISE_HIGH": "claude-opus-5-5"
    // GITHUB_CLIENT_ID, GITHUB_APP_SLUG and GITHUB_APP_CLIENT_ID are set as secrets with the rest,
    // so the GitHub apps can be swapped without a deploy.
  },
  // Secrets per environment (wrangler secret put [--env staging] / .dev.vars): ANTHROPIC_API_KEY,
  // AWS_SES_ACCESS_KEY_ID and AWS_SES_SECRET_ACCESS_KEY (Amazon SES; both set and SES sends the mail,
  // region eu-west-1 unless the AWS_SES_REGION var says otherwise), RESEND_API_KEY (the fallback), GITHUB_TOKEN, LINK_SECRET (HMAC for one-click links) and CHANNEL_KEY (32 bytes,
  // base64: `openssl rand -base64 32`; encrypts Slack webhook URLs and GitHub installation tokens),
  // ADMIN_EMAILS, GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET (OAuth app for sign-in), and the GitHub
  // App's GITHUB_APP_SLUG, GITHUB_APP_CLIENT_ID, GITHUB_APP_CLIENT_SECRET, GITHUB_APP_PRIVATE_KEY,
  // GITHUB_WEBHOOK_SECRET. MAIL_FROM defaults to "Stackquake <alerts@stackquake.com>".
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "stackquake-staging",
      "routes": [{ "pattern": "staging.stackquake.com", "custom_domain": true }],
      "workers_dev": false,
      // No cron: the account's 5 Free-plan triggers are another-project's 1 and production's 3, and a
      // second poller would double vendor traffic and LLM spend. /admin/staging runs ticks by hand.
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stackquake-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "stackquake-staging-snapshots" }],
      "vars": {
        "JOBS_PER_TICK": "20",
        "ALERT_JOBS_PER_TICK": "10",
        "HEAVY_PER_TICK": "10",
        "LLM_MODEL_CLASSIFY": "claude-haiku-5-5",
        "LLM_MODEL_SUMMARISE": "claude-haiku-5-5",
        "LLM_MODEL_SUMMARISE_HIGH": "claude-opus-5-5",
        "APP_ORIGIN": "https://staging.stackquake.com",
        "STAGING_TOOLS": "1",
        "LLM_WEEKLY_BUDGET_USD": "2"
      }
    }
  }
}
