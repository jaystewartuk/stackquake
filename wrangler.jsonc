{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stackquake",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Generates src/catalog/catalog.gen.json from catalog/*.yaml before dev and deploy.
  "build": { "command": "node scripts/build-catalog.mjs" },
  "triggers": {
    // */5 and 3-58/5: claim and run due jobs (two ticks every 5 minutes, each with its own CPU
    // budget). Daily: sync catalog, schedule overdue polls, digests, budget check, prune.
    // 3 of the account's 5 Free-plan cron triggers.
    "crons": ["*/5 * * * *", "3-58/5 * * * *", "7 6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stackquake",
      // Placeholder until M5 creates the real database. Local dev and tests only.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "stackquake-snapshots" }],
  "vars": {
    "JOBS_PER_TICK": "3",
    // Fan-out, delivery and digest jobs per tick, on top of JOBS_PER_TICK (docs/DECISIONS.md, M4).
    "ALERT_JOBS_PER_TICK": "2",
    // Model per pipeline step (docs/DECISIONS.md, M2). Changing one is a config change only.
    "LLM_MODEL_CLASSIFY": "claude-haiku-5-5",
    "LLM_MODEL_SUMMARISE": "claude-haiku-5-5",
    "LLM_MODEL_SUMMARISE_HIGH": "claude-opus-5-5"
  },
  // Secrets (wrangler secret put / .dev.vars): ANTHROPIC_API_KEY, GITHUB_TOKEN, GITHUB_CLIENT_SECRET,
  // RESEND_API_KEY, LINK_SECRET (HMAC for one-click links in alerts) and CHANNEL_KEY (32 bytes,
  // base64: `openssl rand -base64 32`; encrypts Slack webhook URLs).
  // Also set per environment (M5): ADMIN_EMAILS (comma-separated), GITHUB_CLIENT_ID, MAIL_FROM
  // (default "Stackquake <alerts@stackquake.com>"), LLM_WEEKLY_BUDGET_USD (default 10), and
  // APP_ORIGIN for staging (emailed links default to https://stackquake.com).
  "observability": { "enabled": true }
}
